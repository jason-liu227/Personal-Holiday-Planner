<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/planner_teal"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/formTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/planner_teal"
                android:text="Plan Trip"
                android:textAlignment="center"
                android:textColor="@color/planner_teal"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <EditText
        android:id="@+id/destinationInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Location"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="161dp" />

    <EditText
        android:id="@+id/budgetInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number"
        android:text="00.00"
        tools:layout_editor_absoluteX="2dp"
        tools:layout_editor_absoluteY="241dp" />

    <EditText
        android:id="@+id/startDateInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="date"
        tools:layout_editor_absoluteX="-21dp"
        tools:layout_editor_absoluteY="337dp" />

    <EditText
        android:id="@+id/endDateInput"
        android:layout_width="188dp"
        android:layout_height="46dp"
        android:ems="10"
        android:inputType="date"
        tools:layout_editor_absoluteX="221dp"
        tools:layout_editor_absoluteY="336dp" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="117dp"
        android:layout_height="62dp"
        android:backgroundTint="@color/planner_teal"
        android:text="Save"
        android:textColor="@color/planner_white"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="546dp" />

    <Button
        android:id="@+id/cancelButton"
        android:layout_width="117dp"
        android:layout_height="62dp"
        android:layout_marginStart="292dp"
        android:backgroundTint="@color/planner_red"
        android:text="Cancel"
        android:textColor="@color/planner_white"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="546dp" />

</androidx.constraintlayout.widget.ConstraintLayout>