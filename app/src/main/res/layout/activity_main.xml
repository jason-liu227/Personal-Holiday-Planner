<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainTitle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/planner_background">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top settings button -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Personal Holiday Planner"
            android:textAlignment="center"
            android:textColor="@color/planner_teal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your next adventure awaits!"
            android:textAlignment="center"
            android:textColor="@color/planner_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/viewTripsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/planner_teal"
            android:text="View Planned Trips"
            android:textColor="@color/planner_white" />

        <Button
            android:id="@+id/returnButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/planner_teal"
            android:text="Plan Trip"
            android:textColor="@color/planner_white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/planner_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/viewTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="☷&#10;View"
            android:textAllCaps="false"
            android:backgroundTint="@color/planner_white"
            android:textColor="@color/planner_teal" />

        <Button
            android:id="@+id/addTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/planner_white"
            android:text="+&#10;Add"
            android:textAllCaps="false"
            android:textColor="@color/planner_teal" />

        <Button
            android:id="@+id/settingsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/planner_white"
            android:text="⚙&#10;Settings"
            android:textAllCaps="false"
            android:textColor="@color/planner_teal" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
